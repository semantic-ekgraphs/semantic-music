# --- ViewQA1: Avaliação geral da Exported View
<EV/DBpedia> :hasQualityAnnotation ex:ViewQA1.
ex:ViewQA1 a :ViewQualityAnnotation ;
	oa:hasBody "View com algumas triplas com inconsistências." ;
	dqv:inDimension dqv:Consistency;
    dqv:derivedFrom ex:TripleQA1, ex:TripleQA2, ex:TripleQA3, ex:TripleQA4, ex:TripleQA5, ex:TripleQA6 .




# --- Métrica 1: Verifica múltiplos valores em propriedades únicas
<Metric/ConsistencyMetric1> a dqv:Metric ;
    rdfs:label "Propriedades Únicas com Múltiplos Valores"@pt ;
    rdfs:comment "Verifica se propriedades definidas como únicas possuem mais de um valor atribuído, violando restrições de unicidade."@pt ;
    dqv:inDimension dqv:Consistency ;
    dqv:expectedDataType xsd:float .
    

# --- Métrica 2: Verifica o uso correto de propriedades
<Metric/ConsistencyMetric2> a dqv:Metric ;
    rdfs:label "Validação de Tipo de Propriedade"@pt ;
    rdfs:comment "Verifica se propriedades do tipo owl:ObjectProperty e owl:DatatypeProperty são utilizadas de acordo com sua definição. Por exemplo, uma owl:ObjectProperty não deve apontar para um literal."@pt ;
    dqv:inDimension dqv:Consistency ;
    dqv:expectedDataType xsd:float .

# --- Métrica 3: Verifica se o formato do dados está correto
<Metric/ConsistencyMetric3> a dqv:Metric ;
    rdfs:label "Validação do formato do dado"@pt ;
    rdfs:comment "Verifica se dado está formatado corretamente."@pt ;
    dqv:inDimension dqv:Consistency ;
    dqv:expectedDataType xsd:float .


