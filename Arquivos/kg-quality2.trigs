# ARTIST - DBPEDIA
	

<< <http://dbpedia.org/resource/Stevie_Wonder> foaf:name "Stevie Wonder" >> :hasQualityAnnotation ex:TripleQA1.
<< <http://dbpedia.org/resource/Stevie_Wonder> dc:description """Stevland Hardaway Morris, known professionally as Stevie Wonder...""" >> :hasQualityAnnotation ex:TripleQA2.
<< <http://dbpedia.org/resource/Stevie_Wonder> foaf:made "Talking Book" >> :hasQualityAnnotation ex:TripleQA3.

<http://dbpedia.org/resource/Stevie_Wonder> :hasQualityAnnotation ex:InstanceQA1.

# --- TripleQA1: Inconsistência em propriedades únicas
ex:TripleQA1 a :TripleQualityAnnotation ;
    oa:hasBody "Inconsistência detectada: Propriedades definidas como únicas não devem possuir múltiplos valores." ;
    dqv:inDimension dqv:Consistency;
    dqv:derivedFrom ex:QM1, ex:QM2.

ex:QM1 a dqv:QualityMeasurement;
  	dqv:isMeasurementOf <Metric/ConsistencyMetric1>;
    dqv:inDimension dqv:Consistency;
    dqv:value "0.0"^^xsd:float .
    
ex:QM2 a dqv:QualityMeasurement;
	dqv:isMeasurementOf <Metric/ConsistencyMetric2>;
    dqv:inDimension dqv:Consistency;
    dqv:value "1.0"^^xsd:float .


# --- TripleQA2: Tripla sem inconsistências
ex:TripleQA2 a :TripleQualityAnnotation ;
    oa:hasBody "Tripla consistente. Nenhuma inconsistência encontrada nas métricas ConsistencyMetric1 e ConsistencyMetric2." ;
    dqv:inDimension dqv:Consistency;
    dqv:derivedFrom ex:QM3, ex:QM4.

ex:QM3 a dqv:QualityMeasurement;
	dqv:isMeasurementOf <Metric/ConsistencyMetric1>;
    dqv:inDimension dqv:Consistency;
    dqv:value "1.0"^^xsd:float .
    
ex:QM4 a dqv:QualityMeasurement;
	dqv:isMeasurementOf <Metric/ConsistencyMetric2>;
    dqv:inDimension dqv:Consistency;
    dqv:value "1.0"^^xsd:float .


ex:TripleQA3 a :TripleQualityAnnotation ;
    oa:hasBody "Inconsistência detectada: A propriedade definida como owl:ObjectProperty foi utilizada como owl:DatatypeProperty." ;
    dqv:inDimension dqv:Consistency;
    dqv:derivedFrom ex:QM5, ex:QM6.

ex:QM5 a dqv:QualityMeasurement;
	dqv:isMeasurementOf <Metric/ConsistencyMetric1>;
    dqv:inDimension dqv:Consistency;
    dqv:value "1.0"^^xsd:float .
    
ex:QM6 a dqv:QualityMeasurement;
	dqv:isMeasurementOf <Metric/ConsistencyMetric2>;
    dqv:inDimension dqv:Consistency;
    dqv:value "0.0"^^xsd:float .


# --- InstanceQA1: Avaliação geral da instância
ex:InstanceQA1 a :InstanceQualityAnnotation ;
    oa:hasBody "Instância com baixa qualidade devido a inconsistências identificadas nas triplas ex:TripleQA1 e ex:TripleQA3." ;
	dqv:inDimension dqv:Consistency;
    dqv:derivedFrom ex:TripleQA1, ex:TripleQA2, ex:TripleQA3 ;
    dqv:computedOn <http://dbpedia.org/resource/Stevie_Wonder>.


